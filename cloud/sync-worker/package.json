{
  "name": "rplus-sync-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "cd ../.. && npm run build:cloud-mobile && npm run build:cloud-interno",
    "dev": "wrangler dev",
    "predeploy": "cd ../.. && npm run build:cloud-mobile && npm run build:cloud-interno",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply rplus-sync --local",
    "db:migrate:remote": "wrangler d1 migrations apply rplus-sync --remote",
    "test": "node --test src/**/*.test.js",
    "estimate:free": "node scripts/estimate-free-tier.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.20.0"
  }
}
