{
  "mcpServers": {
    "graphiti": {
      "command": "uvx",
      "args": ["graphiti-mcp"],
      "env": {
        "NEO4J_URI": "bolt://localhost:7687",
        "NEO4J_USER": "neo4j",
        "NEO4J_PASSWORD": "${NEO4J_PASSWORD}",
        "LLM_PROVIDER": "anthropic",
        "LLM_MODEL": "claude-opus-4-8",
        "GRAPHITI_GROUP_ID": "rplus-agent"
      }
    }
  }
}
