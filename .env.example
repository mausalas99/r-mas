# R+ development environment variables (optional dev knobs — no secrets).
# Copy to .env or export in your shell. Values left empty by default.

# Electron userData path override (main.js sets this at runtime; scripts may read it)
# Consumed by: main.js, scripts/dev-nube-test-app.mjs, scripts/dev-ui-test-app.mjs, scripts/e2e/*.mjs
R_PLUS_USER_DATA=

# Alternate LAN/UI HTTP port (default 3738). Use 3739 for a second Nube test app.
# Consumed by: scripts/dev-nube-test-app.mjs, scripts/e2e/harness.mjs
R_PLUS_LAN_HTTP_PORT=

# Web Push for equipos waitlist (generate: npx @pushforge/builder vapid)
# EQUIPOS_VAPID_PUBLIC_KEY=
# EQUIPOS_VAPID_PRIVATE_JWK=
