  "exceptions": [
    {
      "selector": ".visually-hidden",
      "rules": [
        "content-clipping"
      ],
      "reason": "Screen-reader-only text is clipped on purpose."
    },
    {
      "selector": ".tend-seg-btn, .inner-tab, .lab-inner-btn, .exp-group-section, .lab-output-more-item, .settings-nav-item, .settings-theme-btn, .ic-mode-btn, .header-mode-seg-btn, .header-session-cluster .btn-header-icon, .btn-patient-bulk-select, .btn-patient-filters, .settings-head-link, #btn-header-shortcuts, #btn-open-learn, button[role=\"menuitem\"]",
