 "account": {
  "plain": "\n    <form id=\"clinical-profile-form\" class=\"settings-perfil-account\" novalidate>\n      \n      <p class=\"settings-section-label\">Mi cuenta</p>\n      <div class=\"settings-card-stack\">\n        \n        <div class=\"settings-card\">\n          <div class=\"settings-card__copy\">\n            <label class=\"settings-card__title\" for=\"clinical-profile-username\">Usuario</label>\n            <p class=\"settings-card__desc settings-acc-hint settings-acc-hint--tight\">@usuario en minúsculas, sin espacios.</p>\n          </div>\n          <div class=\"settings-card__action\"><input id=\"clinical-profile-username\" type=\"text\" class=\"profile-input\" value=\"dr&lt;m&gt;&amp;&quot;x\" placeholder=\"drmendoza\" autocomplete=\"off\" spellcheck=\"false\" pattern=\"[a-z][a-z0-9_]{2,31}\" required></div>\n        </div>\n        \n        <div class=\"settings-card\">\n          <div class=\"settings-card__copy\">\n            <label class=\"settings-card__title\" for=\"clinical-profile-name\">Nombre en guardia</label>\n            \n          </div>\n          <div class=\"settings-card__action\"><input id=\"clinical-profile-name\" type=\"text\" class=\"profile-input\" value=\"Dra. &lt;Ana&gt; &amp; &quot;Q&quot;\" required></div>\n        </div>\n        \n        <div class=\"settings-card\">\n          <div class=\"settings-card__copy\">\n            <label class=\"settings-card__title\" for=\"clinical-profile-rank\">Rango clínico</label>\n            <p class=\"settings-card__desc settings-acc-hint settings-acc-hint--tight\">Equipos, entregas y alcance.</p>\n          </div>\n          <div class=\"settings-card__action\"><select id=\"clinical-profile-rank\" class=\"profile-input\"><option value=\"R1\" >R1</option><option value=\"R2\" selected>R2</option><option value=\"R3\" >R3</option></select></div>\n        </div>\n        \n        <div class=\"settings-card\">\n          <div class=\"settings-card__copy\">\n            <label class=\"settings-card__title\" for=\"clinical-profile-admin\">Privilegios de administración</label>\n            <p class=\"settings-card__desc settings-acc-hint settings-acc-hint--tight\">Requiere tu código. Rotación, censo global y directorio.</p>\n          </div>\n          <div class=\"settings-card__action\"><input type=\"checkbox\" id=\"clinical-profile-admin\" ></div>\n        </div>\n      </div>\n      \n    </form>",
  "admin": "\n    <form id=\"clinical-profile-form\" class=\"settings-perfil-account\" novalidate>\n      <p class=\"clinical-teams-legacy-banner\">Registra tu @usuario (obligatorio). Sin esto no apareces en equipos ni entregas.</p>\n      <p class=\"settings-section-label\">Mi cuenta</p>\n      <div class=\"settings-card-stack\">\n        \n        <div class=\"settings-card\">\n          <div class=\"settings-card__copy\">\n            <label class=\"settings-card__title\" for=\"clinical-profile-username\">Usuario</label>\n            <p class=\"settings-card__desc settings-acc-hint settings-acc-hint--tight\">@usuario en minúsculas, sin espacios.</p>\n          </div>\n          <div class=\"settings-card__action\"><input id=\"clinical-profile-username\" type=\"text\" class=\"profile-input\" value=\"dr&lt;m&gt;&amp;&quot;x\" placeholder=\"drmendoza\" autocomplete=\"off\" spellcheck=\"false\" pattern=\"[a-z][a-z0-9_]{2,31}\" required></div>\n        </div>\n        \n        <div class=\"settings-card\">\n          <div class=\"settings-card__copy\">\n            <label class=\"settings-card__title\" for=\"clinical-profile-name\">Nombre en guardia</label>\n            \n          </div>\n          <div class=\"settings-card__action\"><input id=\"clinical-profile-name\" type=\"text\" class=\"profile-input\" value=\"Dra. &lt;Ana&gt; &amp; &quot;Q&quot;\" required></div>\n        </div>\n        \n        <div class=\"settings-card\">\n          <div class=\"settings-card__copy\">\n            <label class=\"settings-card__title\" for=\"clinical-profile-rank\">Rango clínico</label>\n            <p class=\"settings-card__desc settings-acc-hint settings-acc-hint--tight\">Equipos, entregas y alcance.</p>\n          </div>\n          <div class=\"settings-card__action\"><select id=\"clinical-profile-rank\" class=\"profile-input\"><option value=\"R1\" >R1</option><option value=\"R2\" >R2</option><option value=\"R3\" >R3</option><option value=\"R4\" selected>R4</option></select></div>\n        </div>\n        \n        <div class=\"settings-card\">\n          <div class=\"settings-card__copy\">\n            <label class=\"settings-card__title\" for=\"clinical-profile-admin\">Privilegios de administración</label>\n            <p class=\"settings-card__desc settings-acc-hint settings-acc-hint--tight\">Requiere tu código. Rotación, censo global y directorio.</p>\n          </div>\n          <div class=\"settings-card__action\"><input type=\"checkbox\" id=\"clinical-profile-admin\" checked><button type=\"button\" class=\"wb-btn wb-btn-ghost wb-btn-sm\" id=\"btn-clinical-admin-code-change\">Cambiar código</button></div>\n        </div>\n      </div>\n      <p class=\"settings-acc-hint settings-acc-hint--tight\">El directorio completo lo abren R4, Admin o quien tenga privilegios de administración.</p>\n    </form>",
  "gate": "\n    <form id=\"clinical-profile-form\" class=\"settings-perfil-account\" novalidate>\n      \n      <p class=\"settings-section-label\">Mi cuenta</p>\n      <div class=\"settings-card-stack\">\n        \n        <div class=\"settings-card\">\n          <div class=\"settings-card__copy\">\n            <label class=\"settings-card__title\" for=\"clinical-profile-username\">Usuario</label>\n            <p class=\"settings-card__desc settings-acc-hint settings-acc-hint--tight\">@usuario en minúsculas, sin espacios.</p>\n          </div>\n          <div class=\"settings-card__action\"><input id=\"clinical-profile-username\" type=\"text\" class=\"profile-input\" value=\"\" placeholder=\"drmendoza\" autocomplete=\"off\" spellcheck=\"false\" pattern=\"[a-z][a-z0-9_]{2,31}\" required></div>\n        </div>\n        \n        <div class=\"settings-card\">\n          <div class=\"settings-card__copy\">\n            <label class=\"settings-card__title\" for=\"clinical-profile-name\">Nombre en guardia</label>\n            \n          </div>\n          <div class=\"settings-card__action\"><input id=\"clinical-profile-name\" type=\"text\" class=\"profile-input\" value=\"\" required></div>\n        </div>\n        \n        <div class=\"settings-card\">\n          <div class=\"settings-card__copy\">\n            <label class=\"settings-card__title\" for=\"clinical-profile-rank\">Rango clínico</label>\n            <p class=\"settings-card__desc settings-acc-hint settings-acc-hint--tight\">Equipos, entregas y alcance.</p>\n          </div>\n          <div class=\"settings-card__action\"><select id=\"clinical-profile-rank\" class=\"profile-input\"><option value=\"R1\" >R1</option><option value=\"R2\" >R2</option><option value=\"R3\" >R3</option><option value=\"R4\" selected>R4</option></select></div>\n        </div>\n        \n        <div class=\"settings-card\">\n          <div class=\"settings-card__copy\">\n            <label class=\"settings-card__title\" for=\"clinical-profile-admin\">Privilegios de administración</label>\n            <p class=\"settings-card__desc settings-acc-hint settings-acc-hint--tight\">Requiere tu código. Rotación, censo global y directorio.</p>\n          </div>\n          <div class=\"settings-card__action\"><input type=\"checkbox\" id=\"clinical-profile-admin\" ></div>\n        </div>\n      </div>\n      \n    </form>"
