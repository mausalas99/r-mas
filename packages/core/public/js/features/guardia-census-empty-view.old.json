{
 "empty-plain": "<div class=\"empty-state guardia-census-empty\" role=\"status\"><h3 class=\"empty-state-title\">No hay pacientes visibles</h3><p class=\"empty-state-lead\">Confirma que estás en Nube con sala y equipo correctos. Si acabas de rotar, abre Mi rotación.</p></div>",
 "empty-filtered": "<div class=\"empty-state guardia-census-empty\" role=\"status\"><h3 class=\"empty-state-title\">No hay pacientes en este alcance</h3><p class=\"empty-state-lead\">Prueba «Censo: todos», o confirma que ya te entregaron en Nube. Si acabas de rotar, abre Mi rotación.</p><div class=\"guardia-census-empty-actions\"><button type=\"button\" class=\"wb-btn wb-btn-primary\" id=\"btn-guardia-census-show-all\">Ver censo completo</button></div></div>",
 "picker-selected": "<div class=\"empty-state guardia-sala-picker\" role=\"status\"><h3 class=\"empty-state-title\">Activar guardia</h3><p class=\"empty-state-lead\">Tu perfil no tiene sala. Elige la que cubres esta noche. Para no ver este paso, pon tu sala en Mi rotación.</p><div class=\"guardia-sala-picker-field\"><label for=\"guardia-sala-picker-select\">Sala</label><select id=\"guardia-sala-picker-select\" class=\"profile-input\"><option value=\"Sala 1\">Sala 1</option><option value=\"Sala 2\" selected>Sala 2</option><option value=\"Urgencias\">Urgencias</option></select></div><div class=\"empty-state-actions\"><button type=\"button\" class=\"wb-btn wb-btn-primary\" id=\"guardia-sala-picker-start\">Empezar guardia</button></div></div>",
 "picker-none": "<div class=\"empty-state guardia-sala-picker\" role=\"status\"><h3 class=\"empty-state-title\">Activar guardia</h3><p class=\"empty-state-lead\">Tu perfil no tiene sala. Elige la que cubres esta noche. Para no ver este paso, pon tu sala en Mi rotación.</p><div class=\"guardia-sala-picker-field\"><label for=\"guardia-sala-picker-select\">Sala</label><select id=\"guardia-sala-picker-select\" class=\"profile-input\"><option value=\"Sala 1\">Sala 1</option><option value=\"Sala 2\">Sala 2</option></select></div><div class=\"empty-state-actions\"><button type=\"button\" class=\"wb-btn wb-btn-primary\" id=\"guardia-sala-picker-start\">Empezar guardia</button></div></div>",
 "picker-nosalas": "<div class=\"empty-state guardia-sala-picker\" role=\"status\"><h3 class=\"empty-state-title\">Activar guardia</h3><p class=\"empty-state-lead\">Tu perfil no tiene sala. Elige la que cubres esta noche. Para no ver este paso, pon tu sala en Mi rotación.</p><div class=\"guardia-sala-picker-field\"><label for=\"guardia-sala-picker-select\">Sala</label><select id=\"guardia-sala-picker-select\" class=\"profile-input\"></select></div><div class=\"empty-state-actions\"><button type=\"button\" class=\"wb-btn wb-btn-primary\" id=\"guardia-sala-picker-start\">Empezar guardia</button></div></div>",
