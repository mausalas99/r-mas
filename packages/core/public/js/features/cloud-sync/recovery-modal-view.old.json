{
 "plain": "<div class=\"lab-conflict-backdrop lab-conflict-backdrop--stacked\" data-recovery-code-modal><div class=\"lab-conflict-modal cloud-sync-recovery-modal material-glass ui-overlay-dialog\" role=\"dialog\" aria-modal=\"true\"><h3 style=\"margin:0 0 10px;\">Código de recuperación</h3><p style=\"font-size:13px;line-height:1.45;margin:0 0 14px;color:var(--text-muted);\">Guarda este código de recuperación. No lo volveremos a mostrar.</p><div style=\"display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin:0 0 14px;\"><code data-recovery-code style=\"font-family:ui-monospace,monospace;font-size:15px;letter-spacing:0.04em;padding:10px 12px;border-radius:8px;border:1px solid var(--border);background:var(--surface);flex:1;min-width:0;word-break:break-all;\">ABCD-EFGH-1234</code><button type=\"button\" data-recovery-copy class=\"cloud-sync-btn cloud-sync-btn--ghost\" style=\"flex-shrink:0;\">Copiar</button></div><label style=\"display:flex;gap:8px;align-items:flex-start;font-size:13px;line-height:1.4;cursor:pointer;margin:0 0 16px;\"><input type=\"checkbox\" data-recovery-confirm style=\"margin-top:3px;flex-shrink:0;\" /><span>Lo guardé en un lugar seguro</span></label><div style=\"display:flex;justify-content:flex-end;\"><button type=\"button\" data-recovery-continue class=\"cloud-sync-btn\" disabled>Continuar</button></div></div></div>",
 "titled": "<div class=\"lab-conflict-backdrop lab-conflict-backdrop--stacked\" data-recovery-code-modal><div class=\"lab-conflict-modal cloud-sync-recovery-modal material-glass ui-overlay-dialog\" role=\"dialog\" aria-modal=\"true\"><h3 style=\"margin:0 0 10px;\">Código &lt;nuevo&gt; &amp; &quot;listo&quot;</h3><p style=\"font-size:13px;line-height:1.45;margin:0 0 14px;color:var(--text-muted);\">Guarda este código de recuperación. No lo volveremos a mostrar.</p><div style=\"display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin:0 0 14px;\"><code data-recovery-code style=\"font-family:ui-monospace,monospace;font-size:15px;letter-spacing:0.04em;padding:10px 12px;border-radius:8px;border:1px solid var(--border);background:var(--surface);flex:1;min-width:0;word-break:break-all;\">A&lt;B&gt;&amp;&quot;C</code><button type=\"button\" data-recovery-copy class=\"cloud-sync-btn cloud-sync-btn--ghost\" style=\"flex-shrink:0;\">Copiar</button></div><label style=\"display:flex;gap:8px;align-items:flex-start;font-size:13px;line-height:1.4;cursor:pointer;margin:0 0 16px;\"><input type=\"checkbox\" data-recovery-confirm style=\"margin-top:3px;flex-shrink:0;\" /><span>Lo guardé en un lugar seguro</span></label><div style=\"display:flex;justify-content:flex-end;\"><button type=\"button\" data-recovery-continue class=\"cloud-sync-btn\" disabled>Continuar</button></div></div></div>"
