{
  "bootDefault": "\n    <div class=\"clinical-onboarding-stage\">\n      <div class=\"clinical-onboarding-stage-inner\">\n        \n        <h3 class=\"clinical-onboarding-title\">Preparando R+</h3>\n        <div class=\"clinical-onboard-boot-loader\" role=\"status\" aria-live=\"polite\" aria-busy=\"true\">\n          <div class=\"clinical-onboard-boot-loader-row\">\n            <span class=\"clinical-onboard-boot-spinner\" aria-hidden=\"true\"></span>\n            <p class=\"clinical-onboarding-status clinical-onboard-boot-progress-label\">Iniciando R+…</p>\n          </div>\n          <div class=\"clinical-onboard-boot-progress-track\" aria-hidden=\"true\">\n            <div class=\"clinical-onboard-boot-progress-bar\" style=\"width:3%\"></div>\n          </div>\n        </div>\n      </div>\n    </div>",
  "bootStep2": "\n    <div class=\"clinical-onboarding-stage\">\n      <div class=\"clinical-onboarding-stage-inner\">\n        <div class=\"clinical-onboarding-progress\" role=\"progressbar\" aria-label=\"Progreso del registro\" aria-valuemin=\"1\" aria-valuemax=\"3\" aria-valuenow=\"2\">\n          <span class=\"clinical-onboarding-progress-label\">Paso 2 de 3 · Perfil</span>\n          <span class=\"clinical-onboarding-progress-track\"><span class=\"is-done\"></span><span class=\"is-active\"></span><span class=\"\"></span></span>\n        </div>\n        <h3 class=\"clinical-onboarding-title\">Preparando R+</h3>\n        <div class=\"clinical-onboard-boot-loader\" role=\"status\" aria-live=\"polite\" aria-busy=\"true\">\n          <div class=\"clinical-onboard-boot-loader-row\">\n            <span class=\"clinical-onboard-boot-spinner\" aria-hidden=\"true\"></span>\n            <p class=\"clinical-onboarding-status clinical-onboard-boot-progress-label\">Cargando formulario…</p>\n          </div>\n          <div class=\"clinical-onboard-boot-progress-track\" aria-hidden=\"true\">\n            <div class=\"clinical-onboard-boot-progress-bar\" style=\"width:3%\"></div>\n          </div>\n        </div>\n      </div>\n    </div>",
  "bootStep1": "\n    <div class=\"clinical-onboarding-stage\">\n      <div class=\"clinical-onboarding-stage-inner\">\n        <div class=\"clinical-onboarding-progress\" role=\"progressbar\" aria-label=\"Progreso del registro\" aria-valuemin=\"1\" aria-valuemax=\"3\" aria-valuenow=\"1\">\n          <span class=\"clinical-onboarding-progress-label\">Paso 1 de 3 · Modo</span>\n          <span class=\"clinical-onboarding-progress-track\"><span class=\"is-active\"></span><span class=\"\"></span><span class=\"\"></span></span>\n        </div>\n        <h3 class=\"clinical-onboarding-title\">T &lt;1&gt; &amp; &quot;x&quot;</h3>\n        <div class=\"clinical-onboard-boot-loader\" role=\"status\" aria-live=\"polite\" aria-busy=\"true\">\n          <div class=\"clinical-onboard-boot-loader-row\">\n            <span class=\"clinical-onboard-boot-spinner\" aria-hidden=\"true\"></span>\n            <p class=\"clinical-onboarding-status clinical-onboard-boot-progress-label\">M &lt;b&gt; &amp; 'c'</p>\n          </div>\n          <div class=\"clinical-onboard-boot-progress-track\" aria-hidden=\"true\">\n            <div class=\"clinical-onboard-boot-progress-bar\" style=\"width:3%\"></div>\n          </div>\n        </div>\n      </div>\n    </div>",
  "bootStep3": "\n    <div class=\"clinical-onboarding-stage\">\n      <div class=\"clinical-onboarding-stage-inner\">\n        <div class=\"clinical-onboarding-progress\" role=\"progressbar\" aria-label=\"Progreso del registro\" aria-valuemin=\"1\" aria-valuemax=\"3\" aria-valuenow=\"3\">\n          <span class=\"clinical-onboarding-progress-label\">Paso 3 de 3 · Equipo</span>\n          <span class=\"clinical-onboarding-progress-track\"><span class=\"is-done\"></span><span class=\"is-done\"></span><span class=\"is-active\"></span></span>\n        </div>\n        <h3 class=\"clinical-onboarding-title\">Preparando R+</h3>\n        <div class=\"clinical-onboard-boot-loader\" role=\"status\" aria-live=\"polite\" aria-busy=\"true\">\n          <div class=\"clinical-onboard-boot-loader-row\">\n            <span class=\"clinical-onboard-boot-spinner\" aria-hidden=\"true\"></span>\n            <p class=\"clinical-onboarding-status clinical-onboard-boot-progress-label\">Iniciando R+…</p>\n          </div>\n          <div class=\"clinical-onboard-boot-progress-track\" aria-hidden=\"true\">\n            <div class=\"clinical-onboard-boot-progress-bar\" style=\"width:3%\"></div>\n          </div>\n        </div>\n      </div>\n    </div>",
  "sessionRetry": "\n    <div class=\"clinical-onboarding-stage\">\n      <div class=\"clinical-onboarding-stage-inner\">\n        \n        <h3 class=\"clinical-onboarding-title\">Sesión clínica</h3>\n        <div class=\"clinical-onboarding-lead\"><p>La base local ya está abierta, pero la sesión clínica no inició. Pulsa Reintentar abajo.</p></div>\n        <div class=\"modal-actions clinical-onboard-session-actions\"><button type=\"button\" class=\"wb-btn wb-btn-primary wb-btn-lg\" id=\"clinical-onboard-retry-session-btn\">Reintentar</button></div>\n      </div>\n    </div>",
  "sessionBlocked": "\n    <div class=\"clinical-onboarding-stage\">\n      <div class=\"clinical-onboarding-stage-inner\">\n        \n        <h3 class=\"clinical-onboarding-title\">Sesión clínica</h3>\n        <div class=\"clinical-onboarding-lead\"><p>Reinstala desde GitHub o usa Ajustes → Aplicación → Reinstalar &lt;versión&gt; &amp; &quot;actual&quot;.</p></div>\n        \n      </div>\n    </div>",
  "localOnly": "\n    <div class=\"clinical-onboarding-stage\">\n      <div class=\"clinical-onboarding-stage-inner\">\n        <div class=\"clinical-onboarding-progress\" role=\"progressbar\" aria-label=\"Progreso del registro\" aria-valuemin=\"1\" aria-valuemax=\"3\" aria-valuenow=\"2\">\n          <span class=\"clinical-onboarding-progress-label\">Paso 2 de 3 · Perfil</span>\n          <span class=\"clinical-onboarding-progress-track\"><span class=\"is-done\"></span><span class=\"is-active\"></span><span class=\"\"></span></span>\n        </div>\n        <h3 class=\"clinical-onboarding-title\">Solo este equipo</h3>\n        <div class=\"clinical-onboarding-lead\"><p>Los expedientes y notas quedan solo en esta Mac. Sin Nube, rotaciones ni sala compartida.</p></div>\n        \n      <p id=\"onboard-local-only-error\" class=\"clinical-registration-error\" hidden></p>\n      <div class=\"modal-actions clinical-onboard-form-actions\">\n        <button type=\"button\" class=\"wb-btn wb-btn-primary wb-btn-lg\" id=\"clinical-onboard-local-confirm-btn\">Entrar a R+</button>\n        <button type=\"button\" id=\"clinical-onboard-mode-back-btn\" class=\"wb-btn wb-btn-secondary\">Cambiar modo</button>\n      </div>\n      </div>\n    </div>",
